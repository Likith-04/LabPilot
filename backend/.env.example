# RAG PDF Chat backend environment template
#
# Do not commit real secrets. In production, set these in your hosting
# platform's environment/secrets UI.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
PORT=3000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Model defaults
# -----------------------------------------------------------------------------
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.0
MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Provider keys
#
# Set at least one chat provider key. For PDF indexing, use an embedding-capable
# provider such as OpenRouter, Gemini, Hugging Face, or OpenAI direct.
# If no cloud embedding provider is available, the app falls back to local
# sentence-transformers, which needs more RAM and downloads model files on first use.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
GOOGLE_API_KEY=
HF_API_KEY=
OPENAI_DIRECT_API_KEY=
EMBEDDING_OPENAI_DIRECT=false

# -----------------------------------------------------------------------------
# RAG settings
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
FAISS_PERSIST_DIR=faiss_index
MAX_VECTOR_SESSIONS=64
FAISS_SESSION_MAX_AGE_DAYS=3

# -----------------------------------------------------------------------------
# Rate limits
#
# Per-client-IP rolling 60-second windows. Set to 0 to disable.
# -----------------------------------------------------------------------------
RATE_LIMIT_UPLOAD_PER_MINUTE=8
RATE_LIMIT_ASK_PER_MINUTE=90

# -----------------------------------------------------------------------------
# Optional observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
